{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/octanevz/codex-debate/blob/main/plugins/codex-debate/skills/debate-report/schema/debate-report.schema.json",
  "title": "codex-debate report (schemaVersion 1)",
  "description": "Input contract for scripts/render_debate_report.py. Authored within the keyword subset that scripts/validate_debate_report.py interprets: type, properties, required, additionalProperties, enum, const, items, minItems, pattern, oneOf, $ref/$defs.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "subject": { "type": "string" },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["claude", "codex"] }
    },
    "shape": { "type": "string" },
    "mode": { "enum": ["auto", "interactive", "deadlock"] },
    "rigor": { "enum": ["advisory", "binding"] },
    "roundCap": { "type": "integer" },
    "termination": { "type": "string" },
    "bindingAnchor": { "type": ["string", "null"] },
    "preRegistered": { "$ref": "#/$defs/lockedPanel" },
    "blindCommit": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lockedPanel" }
        },
        "overlapNote": { "type": "string" }
      },
      "required": ["columns"],
      "additionalProperties": false
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/round" }
    },
    "verdict": {
      "type": "object",
      "properties": {
        "agreed": {
          "type": "array",
          "items": { "$ref": "#/$defs/verdictItem" }
        },
        "unresolved": {
          "type": "array",
          "items": { "$ref": "#/$defs/verdictItem" }
        },
        "devilsAdvocate": { "$ref": "#/$defs/devilsAdvocate" }
      },
      "required": ["agreed", "unresolved"],
      "additionalProperties": false
    },
    "freshEyes": {
      "type": "object",
      "properties": {
        "speaker": { "enum": ["claude", "codex"] },
        "sessionBadge": { "type": "string" },
        "role": { "type": "string" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        }
      },
      "required": ["speaker", "sessionBadge", "role", "messages"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "subject",
    "date",
    "participants",
    "shape",
    "mode",
    "rigor",
    "roundCap",
    "termination",
    "bindingAnchor",
    "rounds",
    "verdict"
  ],
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["id", "text"],
      "additionalProperties": false
    },
    "lockedPanel": {
      "type": "object",
      "properties": {
        "speaker": { "enum": ["claude", "codex"] },
        "role": { "type": "string" },
        "lockLabel": { "type": "string" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      },
      "required": ["speaker", "role", "lockLabel", "findings"],
      "additionalProperties": false
    },
    "round": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        }
      },
      "required": ["messages"],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "speaker": { "enum": ["claude", "codex", "codex-fresh"] },
        "role": { "type": "string" },
        "objection": { "$ref": "#/$defs/objection" },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contentBlock" }
        }
      },
      "required": ["speaker", "role", "content"],
      "additionalProperties": false
    },
    "objection": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "enum": ["accepted", "rejected", "unresolved"] },
        "reason": { "type": "string" }
      },
      "required": ["id", "title", "status", "reason"],
      "additionalProperties": false
    },
    "contentBlock": {
      "oneOf": [
        { "$ref": "#/$defs/paragraphBlock" },
        { "$ref": "#/$defs/listBlock" },
        { "$ref": "#/$defs/codeBlock" }
      ]
    },
    "paragraphBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "paragraph" },
        "text": { "type": "string" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "listBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "list" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "required": ["type", "items"],
      "additionalProperties": false
    },
    "codeBlock": {
      "type": "object",
      "properties": {
        "type": { "const": "code" },
        "code": { "type": "string" }
      },
      "required": ["type", "code"],
      "additionalProperties": false
    },
    "verdictItem": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "attribution": { "type": "string" }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "devilsAdvocate": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "outcome": { "type": "string" },
        "intro": { "type": "string" },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/daPoint" }
        }
      },
      "required": ["title", "outcome", "intro", "points"],
      "additionalProperties": false
    },
    "daPoint": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["text"],
      "additionalProperties": false
    }
  }
}
