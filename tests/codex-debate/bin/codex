#!/usr/bin/env bash
# Stub codex CLI for codex-debate skill tests.
# Contract:
#   - Replays scripted replies from $STUB_REPLIES/reply-N.md (N = call number).
#   - Records argv and the full stdin prompt under $STUB_LOG/call-N/.
#   - Mimics real CLI sharp edges: `exec resume` rejects -s/--sandbox/--color
#     with exit 2; session id printed in the run header.
#   - Fault injection: $STUB_REPLIES/rc-N forces that exit code for call N.
set -u

: "${STUB_LOG:?STUB_LOG must be set}"
: "${STUB_REPLIES:?STUB_REPLIES must be set}"

SESSION_ID="0199aaaa-bbbb-7ccc-8ddd-eeeeffff0001"

# --- version/help probes: answer like the real CLI, without consuming a call ---
case "${1:-}" in
    --version | -V)
        echo "codex-cli 0.58.0"
        exit 0
        ;;
    --help | -h)
        echo "Codex CLI"
        echo "Usage: codex [OPTIONS] [COMMAND]"
        exit 0
        ;;
esac
case "${2:-}" in
    --help | -h)
        echo "Run a prompt non-interactively"
        echo "Usage: codex exec [OPTIONS] [PROMPT]"
        exit 0
        ;;
esac

# --- allocate call number (no concurrency expected in tests) ---
n=1
while [ -d "$STUB_LOG/call-$n" ]; do n=$((n + 1)); done
CALL_DIR="$STUB_LOG/call-$n"
mkdir -p "$CALL_DIR"
printf '%s\n' "$@" > "$CALL_DIR/argv.txt"

# --- parse argv ---
is_resume=0
out_file=""
prev=""
for a in "$@"; do
    [ "$a" = "resume" ] && is_resume=1
    [ "$prev" = "-o" ] && out_file="$a"
    prev="$a"
done

# stdin is the prompt (the skill always pipes `- < prompt.md`)
cat > "$CALL_DIR/prompt.md"

# --- real-CLI flag enforcement on resume ---
if [ "$is_resume" = 1 ]; then
    for a in "$@"; do
        case "$a" in
            -s | --sandbox | --color)
                echo "error: unexpected argument '$a' found" >&2
                echo "REJECTED: $a" > "$CALL_DIR/rejected.txt"
                exit 2
                ;;
        esac
    done
fi

# --- run header, resembling real codex output ---
cat << EOF
--------
workdir: $PWD
model: gpt-5.6-sol
provider: openai
approval: never
sandbox: read-only
reasoning effort: medium
session id: $SESSION_ID
--------
EOF

# --- fault injection ---
if [ -f "$STUB_REPLIES/rc-$n" ]; then
    rc=$(cat "$STUB_REPLIES/rc-$n")
    echo "stub: injected failure for call $n" >&2
    exit "$rc"
fi

# --- reply ---
REPLY="$STUB_REPLIES/reply-$n.md"
if [ ! -f "$REPLY" ]; then
    echo "stub: no scripted reply for call $n" >&2
    echo "MISSING-REPLY" > "$CALL_DIR/missing-reply.txt"
    exit 1
fi

if [ -n "$out_file" ]; then
    cp "$REPLY" "$out_file"
else
    # real codex without -o prints the final message to stdout
    cat "$REPLY"
fi
exit 0
