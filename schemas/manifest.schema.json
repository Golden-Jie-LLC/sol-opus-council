{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-jie-llc.github.io/sol-opus-council/schemas/manifest.schema.json",
  "title": "Council run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "created_at", "context_hash", "review_rounds", "model", "usage"],
  "properties": {
    "schema_version": { "type": "integer" },
    "run_id": { "type": "string" },
    "mode": { "type": "string", "enum": ["QUESTION", "PROMPT"] },
    "created_at": { "type": "string" },
    "context_hash": { "type": "string" },
    "review_rounds": { "type": "integer", "minimum": 0, "maximum": 10 },
    "model": { "type": "object" },
    "usage": { "type": "array" }
  }
}
