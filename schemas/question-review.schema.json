{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golden-jie-llc.github.io/sol-opus-council/schemas/question-review.schema.json",
  "title": "QUESTION review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "round",
    "verdict",
    "accepted_resolutions",
    "blocking_objections",
    "non_blocking_suggestions",
    "incorrect_or_missing_assumptions",
    "proposed_changes"
  ],
  "properties": {
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "verdict": { "type": "string", "enum": ["AGREEMENT", "DISPUTE_REMAINS"] },
    "accepted_resolutions": { "type": "array", "items": { "type": "string" } },
    "blocking_objections": { "$ref": "#/$defs/objections" },
    "non_blocking_suggestions": { "type": "array", "items": { "type": "string" } },
    "incorrect_or_missing_assumptions": { "type": "array", "items": { "type": "string" } },
    "proposed_changes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "issue", "why_it_matters", "required_change"],
        "properties": {
          "id": { "type": "string" },
          "target": { "type": "string" },
          "issue": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "required_change": { "type": "string" }
        }
      }
    }
  }
}
